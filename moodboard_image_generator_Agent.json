    {
      "parameters": {
        "options": {
          "systemMessage": "Role: You are an expert image generation prompt engineer. \n\nTask: Your role is to take a simple input idea (e.g., \u201cbohemian rugs, neutral tones\u201d) and transform it into one detailed, polished prompt for creating a high-quality moodboard. \n\nWhen creating the prompt, follow these guidelines: - Highlight the style, colors, and textures implied in the trend. \n\n- Include close-up material textures, styled interior spaces, and decor elements that complement the rug\u2019s look. \n\n- Arrange visuals as a clean, inspiration-ready collection that a design team could immediately use for trend insights. \n\n- Ensure the final output is ready-to-use, simple, and efficient for an image generator.\n\nCritical Rules\nOutput only the final prompt.\nDo not include explanations, introductions, titles, labels, bullet points, quotation marks, markdown formatting, or additional commentary.\nDo not mention that you are generating a prompt.\nReturn exactly one polished prompt and nothing else."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        336,
        0
      ],
      "id": "76d0ef33-eb5f-4cce-bdf8-0634bf7f5842",
      "name": "Generate prompt"
    },
    {
      "parameters": {
        "jsCode": "let inputPrompt = $input.first().json.output;\n\n// 1. Remove line breaks\nlet cleanPrompt = inputPrompt.split(/\\r?\\n/).join(\" \");\n\n// 2. Remove Markdown (** and * bullets)\ncleanPrompt = cleanPrompt.replace(/\\*\\*/g, \"\").replace(/\\*/g, \"\");\n\n// 3. Replace double quotes with single quotes\ncleanPrompt = cleanPrompt.replace(/\"/g, \"'\");\n\n// 4. Build n8n-compatible return\nreturn [\n  {\n    json: {\n      prompt: cleanPrompt\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        0
      ],
      "id": "e5ac5965-e005-46b7-bfbc-20c076743e4b",
      "name": "Clean prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/nscale/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_HUGGINGFACE_API_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": " image/png"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"black-forest-labs/FLUX.1-schnell\",\n  \"prompt\": \"{{ $json.prompt }}\",\n  \"response_format\": \"b64_json\"\n}",
        "options": {
          "response": {
